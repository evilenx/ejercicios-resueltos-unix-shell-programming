# Set PHONEBOOK to point to the phone book file
: ${PHONEBOOK:="$HOME/phonebook"}
export PHONEBOOK

if [ ! -e "$PHONEBOOK" ]; then
    echo "$PHONEBOOK does not exist!"
    printf "Should I create it for you (y/n)? "
    read answer

    if [ "$answer" != "y" ]; then
        exit 1
    fi

    > "$PHONEBOOK" || exit 1
fi

# Function to check if variable names are valid
check_invalid() {
    if [ $# -eq 0 ]; then
        echo "Usage: check_invalid varname1 varname2 ... varnamen"
        return 1
    fi

    for varname in "$@"; do
        if [[ "$varname" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
            echo "$varname VALID."
        else
            echo "$varname INVALID."
        fi
    done
}

# Function to check if input is a "yes" response
is_yes() {
    if [ $# -ne 1 ]; then
        return 1
    fi

    local input
    input=$(echo "$1" | tr '[:upper:]' '[:lower:]')

    [[ "$input" == "yes" || "$input" == "y" ]]
}

# Function to add someone to the phonebook
add_entry() {
    echo "Type in your new entry"
    echo "When you're done, type just a single Enter on the line."

    local first=""
    local entry=""
    local line

    while true; do
        printf ">> "
        read line
        if [ -n "$line" ]; then
            entry="${entry}${line}^"
            [ -z "$first" ] && first="$line"
        else
            break
        fi
    done

    echo "$entry" >> "$PHONEBOOK"
    sort -o "$PHONEBOOK" "$PHONEBOOK"
    echo
    echo "$first has been added to the phone book"
}

# Function to look someone up
lookup_entry() {
    for name in "$@"; do
        tmpfile=$(mktemp)
        grep -i "$name" "$PHONEBOOK" > "$tmpfile"

        if [ ! -s "$tmpfile" ]; then
          echo "I can't find $name in the phone book"
        else
          while IFS= read -r line; do
            display_entry "$line"
              done < "$tmpfile"
              fi
        rm -f "$tmpfile"
    done
}

# List all entries
list_all() {
    IFS='^'
    echo "-----------------------------------------------------"
    while read -r line; do
        set -- $line
        eval printf "\"%-40.40s %s\\n\"" "\"$1\"" "\"\${$#}\""
    done < "$PHONEBOOK"
    echo "-----------------------------------------------------"
}

# Function to display an entry from the phonebook
display_entry() {
    local entry="$1"
    echo
    echo "--------------------------------------"

    IFS="^"
    set -- $entry

    for field in "$1" "$2" "$3" "$4" "$5" "$6"; do
        printf "| %-34.34s |\n" "$field"
    done

    echo "|           o            o           |"
    echo "--------------------------------------"
    echo
}

# IP y MAC
validar_ip_mac() {
    printf "Introduce una dirección IP: "
    read ip
    if [[ $ip =~ ^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$ ]]; then
        echo "La dirección IP $ip es válida."
    else
        echo "La dirección IP $ip no es válida."
    fi

    printf "Introduce una dirección MAC: "
    read mac
    if [[ $mac =~ ^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$ ]]; then
        echo "La dirección MAC $mac es válida."
    else
        echo "La dirección MAC $mac no es válida."
    fi
}

# function tarjeta
luhn() {
    local n="$1" s=0 p=0
    for ((i=${#n}-1; i>=0; i--)); do
        d=${n:i:1}; ((p)) && { d=$((d*2)); ((d>9)) && d=$((d-9)); }
        s=$((s+d)); p=$((1-p))
    done
    ((s%10==0))
}

validar_tarjeta() {
    printf "Número de tarjeta: "
    read tarjeta
    local card=$(echo "$tarjeta" | tr -d ' -')
    [[ $card =~ ^[0-9]{13,19}$ ]] || { echo "Formato invalido"; return 1; }

    if [[ $card =~ ^4[0-9]{12}$ ]] || [[ $card =~ ^4[0-9]{15}$ ]] || [[ $card =~ ^4[0-9]{18}$ ]]; then
        tipo="Visa"
    elif [[ $card =~ ^5[1-5][0-9]{14}$ ]] || [[ $card =~ ^2[2-7][0-9]{14}$ ]]; then
        tipo="MasterCard"
    elif [[ $card =~ ^3[47][0-9]{13}$ ]]; then
        tipo="American Express"
    elif [[ $card =~ ^6011[0-9]{12}$ ]] || [[ $card =~ ^65[0-9]{14}$ ]]; then
        tipo="Discover"
    elif [[ $card =~ ^35[0-9]{14}$ ]]; then
        tipo="JCB"
    else
        tipo="Desconocido"
    fi

    luhn "$card" && echo "$tipo valida: $tarjeta" || echo "$tipo invalida: $tarjeta"
}

# Función de validación de teléfonos de Panamá
validar_telefono_panama() {
    printf "Numero de telefono: "
    read telefono
    local numero=$(echo "$telefono" | tr -d ' ()-')

    if [[ $numero =~ ^\+5076[0-9]{7}$ ]]; then
        echo "Movil Panama valido: $telefono"
    elif [[ $numero =~ ^\+507[2-9][0-9]{6}$ ]]; then
        echo "Fijo Panama valido: $telefono"
    elif [[ $numero =~ ^5076[0-9]{7}$ ]]; then
        echo "Movil Panama valido (agregar +): +$telefono"
    elif [[ $numero =~ ^507[2-9][0-9]{6}$ ]]; then
        echo "Fijo Panama valido (agregar +): +$telefono"
    elif [[ $numero =~ ^6[0-9]{7}$ ]]; then
        echo "Movil Panama valido (formato completo): +507-$telefono"
    elif [[ $numero =~ ^[2-9][0-9]{6}$ ]]; then
        echo "Fijo Panama valido (formato completo): +507-$telefono"
    else
        echo "Numero invalido: $telefono"
    fi
}

# Lookup if arguments are passed
if [ "$#" -ne 0 ]; then
    lookup_entry "$@"
    exit
fi

# Menu loop
while true; do
    printf '

Would you like to:
1. Look someone up
2. Add someone to the phone book
3. Remove someone from the phone book
4. Change an entry in the phone book
5. List all names and numbers in the phone book
6. Check variable names validity
7. Check if input is a "yes" response
8. Validate IP and MAC addresses
9. Validate credit cards
10. Validate Panama phone numbers
11. Exit this program
Please select one of the above (1-11): '

    read choice
    echo
    case "$choice" in
        1)
            printf "Enter name to look up: "
            read name
            if [ -z "$name" ]; then
                echo "Lookup ignored"
            else
                lookup_entry "$name"
            fi
            ;;
        2)
            add_entry
            ;;
        3)
            printf "Enter name to remove: "
            read name
            if [ -z "$name" ]; then
                echo "Removal ignored"
            else
                ./rem "$name"
            fi
            ;;
        4)
            printf "Enter name to change: "
            read name
            if [ -z "$name" ]; then
                echo "Change ignored"
            else
                ./change "$name"
            fi
            ;;
        5)
            list_all
            ;;
        6)
            printf "Enter variable names to check (space-separated): "
            read -a vars
            check_invalid "${vars[@]}"
            ;;
        7)
            printf "Enter a response to check if it's 'yes': "
            read response
            if is_yes "$response"; then
                echo "'$response' is a valid 'yes' response."
            else
                echo "'$response' is not a valid 'yes' response."
            fi
            ;;
        8)
            validar_ip_mac
            ;;
        9)
            validar_tarjeta
            ;;
        10)
            validar_telefono_panama
            ;;
        11)
            exit 0
            ;;
        *)
            echo "Bad choice"
            ;;
    esac
done
